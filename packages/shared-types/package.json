{
  "name": "@arcana/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-package TypeScript types for Arcana.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet'",
    "lint": "echo 'no lint yet'",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
