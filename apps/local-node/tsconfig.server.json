{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "noEmit": false,
    "jsx": "preserve"
  },
  "include": ["src/server/**/*", "src/shared/**/*"],
  "exclude": ["dist", "node_modules", "src/ui", "electron"]
}
