# =================================================================
# Arcana Coffee Intelligence — environment variables (example)
# Copy to `.env` and fill in real values.
# =================================================================

# ---- Database (local node) -------------------------------------
# Default: SQLite file in packages/db-local/prisma/dev.db
DATABASE_URL_LOCAL="file:../../packages/db-local/prisma/dev.db"

# ---- AI service -------------------------------------------------
# Which provider the ai-service should use as the default adapter.
# One of: mock | minimax | anthropic | openrouter | local
# 'mock' is a deterministic offline provider — great for testing the
# full import -> analyze -> display flow without an API key.
AI_PROVIDER="mock"

# AI service port (local-node proxies to this)
AI_SERVICE_URL="http://localhost:4001"
AI_SERVICE_PORT=4001

# ---- Provider: MiniMax (default) -------------------------------
MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-Text-01"
MINIMAX_BASE_URL="https://api.MiniMax.chat/v1"

# ---- Provider: Anthropic (fallback) ----------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Provider: OpenRouter (fallback) ---------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4-6"

# ---- Provider: local LLM (Ollama, etc.) ------------------------
LOCAL_LLM_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3.1:8b"

# ---- local-node app --------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
LOCAL_NODE_PORT=4000
LOCAL_NODE_UI_PORT=3000
