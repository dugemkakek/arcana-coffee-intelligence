# =================================================================
# Arcana Coffee Intelligence — environment variables (example)
# Copy to `.env` and fill in real values.
# =================================================================

# ---- Database (local node) -------------------------------------
# Default: SQLite file in packages/db-local/prisma/dev.db
DATABASE_URL_LOCAL="file:../../packages/db-local/prisma/dev.db"

# ---- AI service -------------------------------------------------
# Which provider the ai-service should use as the default adapter.
# One of: mock | minimax | anthropic | openrouter | local
# 'mock' is a deterministic offline provider — great for testing the
# full import -> analyze -> display flow without an API key.
AI_PROVIDER="mock"

# AI service port (local-node proxies to this)
AI_SERVICE_URL="http://localhost:4001"
AI_SERVICE_PORT=4001

# ---- Provider: MiniMax (default) -------------------------------
MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-Text-01"
MINIMAX_BASE_URL="https://api.minimax.chat/v1"

# ---- Provider: Anthropic (fallback) ----------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Provider: OpenRouter (fallback) ---------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4-6"

# ---- Provider: local LLM (Ollama, etc.) ------------------------
LOCAL_LLM_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3.1:8b"

# ---- local-node app --------------------------------------------
# Fastify API server (local-node backend)
LOCAL_NODE_API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Next.js dev server (UI)
LOCAL_NODE_UI_PORT=3000

# ---- Live Phidget capture --------------------------------------
# Which temperature source the live capture UI should use.
# 'simulator' (default) — generates a realistic synthetic roast curve
#                         so the live UI can be developed/tested without
#                         a real Phidget plugged in.
# 'phidget'  — uses a real TMP1101 thermocouple module via the
#              phidget22 npm package. Requires the Phidget22 driver
#              to be installed system-wide (Windows 7+ supported).
LIVE_SOURCE=simulator

# ---- Two-channel Phidget mapping (only used when LIVE_SOURCE=phidget) ----
# Bean-temp TMP1101 device serial number. If left blank, the first
# TMP1101 discovered on the VINT Hub is used for BT.
# BT_DEVICE_SERIAL=

# Exhaust-temp TMP1101 device serial number. If left blank, the manager
# auto-discovers a second TMP1101 on the same hub. If no second sensor
# is found, ET is estimated as BT + 15°C (the UI shows a banner).
# ET_DEVICE_SERIAL=
